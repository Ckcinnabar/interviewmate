# API keys are managed in the in-app Settings UI and stored in app state.
# Do not place API keys in this file.

# Optional capture behavior
# true = hide this app from screen sharing/screen capture
# false = allow this app to appear in screen sharing/screen capture
HIDE_FROM_SCREEN_CAPTURE=true

# Optional startup mode
# true = start in background mode (window hidden at launch)
# false = show window on startup
START_HIDDEN=false

# Only used when HIDE_FROM_SCREEN_CAPTURE=false: how long (ms) the window
# stays faded out before the screen is captured for a screen question.
SCREENSHOT_DELAY=300

# Optional runtime settings
# Keep NODE_ENV=production during interviews: development opens a DevTools
# window, and that window is not hidden from screen capture.
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=4096
